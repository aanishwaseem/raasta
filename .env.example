# Copy to .env. docker compose reads this file. Every value below is development-only.
POSTGRES_PASSWORD=raasta_dev_password
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
OTP_HMAC_SECRET=dev-only-otp-secret-change-me-0123456789abc
# base64 of exactly 32 bytes: openssl rand -base64 32
DATA_ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE=
AI_INTERNAL_TOKEN=dev-only-ai-internal-token
METRICS_TOKEN=dev-only-metrics-token
# Development only: echo OTP codes in API responses and logs. Must be false in production.
OTP_DEV_ECHO=true
# Optional: enables the LLM-backed assistant in the AI service. Leave empty to use the rule-based fallback.
ANTHROPIC_API_KEY=

# ---- External services (all optional in development; see docs/EXTERNAL_SERVICES.md) ----
# SMS for OTP and safety messages: console (prints to the log, development only) | twilio | http (generic JSON gateway)
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=            # +E.164 number, or a Messaging Service SID starting with MG
# SMS_HTTP_URL=           # POST {to,text,sender} JSON for a local Pakistani SMS aggregator
# SMS_HTTP_AUTH=          # value for the Authorization header, e.g. "Bearer abc"
# SMS_SENDER_ID=Raasta
# Push notifications: console (in-app notification centre only) | fcm (Firebase Cloud Messaging)
PUSH_PROVIDER=console
# FCM_SERVICE_ACCOUNT_JSON=   # Firebase service-account JSON, raw or base64
# Sign in with Google / Apple: comma-separated OAuth client IDs the ID tokens must be issued for
# GOOGLE_CLIENT_IDS=
# APPLE_CLIENT_IDS=
# Logs: auto = JSON lines in production, readable text otherwise
# LOG_FORMAT=auto

# ---- Production (docker-compose.prod.yml) ----
# NEVER reuse the development values above. Generate each secret fresh and keep them in a secrets manager, not in git:
#   JWT_ACCESS_SECRET / OTP_HMAC_SECRET / METRICS_TOKEN / AI_INTERNAL_TOKEN / REDIS_PASSWORD:  openssl rand -base64 48
#   DATA_ENCRYPTION_KEY:                                                                       openssl rand -base64 32
# All four of JWT_ACCESS_SECRET, OTP_HMAC_SECRET, METRICS_TOKEN, AI_INTERNAL_TOKEN must differ and be >= 32 chars.
# The API refuses to start in production with any dev value, OTP_DEV_ECHO=true, PAYMENT_PROVIDER=mock, SMS_PROVIDER=console,
# a non-https/localhost/wildcard CORS origin, or non-https PUBLIC_BASE_URL / TRACKING_BASE_URL.
# REDIS_PASSWORD=
# CORS_ORIGINS=https://admin.example.com
# PUBLIC_BASE_URL=https://api.example.com
# TRACKING_BASE_URL=https://track.example.com
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# Swagger UI is always disabled in production; /metrics requires "Authorization: Bearer $METRICS_TOKEN".
